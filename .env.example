# Replace the example key with a unique, randomly generated secret (at least 16 characters).
COGNISENSE_API_KEYS={"my-project":"example-secret"}

# Optional comma-separated browser origins. Keep empty for server-to-server integrations.
COGNISENSE_CORS_ORIGINS=

# Maximum complete HTTP request size, including multipart overhead (25 MiB by default).
COGNISENSE_MAX_REQUEST_BYTES=26214400
