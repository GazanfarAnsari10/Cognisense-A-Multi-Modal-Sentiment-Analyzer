# Legacy fallback for pre-Phase 6E gateway keys; set false after database-key validation.
COGNISENSE_LEGACY_API_KEYS_ENABLED=true
COGNISENSE_API_KEYS={"my-project":"replace-with-a-random-secret-of-at-least-16-characters"}

# Optional comma-separated browser origins. Keep empty for server-to-server integrations.
COGNISENSE_CORS_ORIGINS=

# Maximum complete HTTP request size, including multipart overhead (25 MiB by default).
COGNISENSE_MAX_REQUEST_BYTES=26214400

# Project-scoped rolling request limit and window.
COGNISENSE_RATE_LIMIT_REQUESTS=60
COGNISENSE_RATE_LIMIT_WINDOW_SECONDS=60

# Rolling 24-hour project quota when no stricter plan quota is set; 0 means no default quota.
COGNISENSE_DEFAULT_DAILY_QUOTA=0

# PostgreSQL connection string for the platform database.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/cognisense
DATABASE_ECHO=false
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_CONNECT_TIMEOUT=10

# Generate a unique random value of at least 32 characters and store it securely.
AUTH_SECRET_KEY=
AUTH_SESSION_TTL_SECONDS=3600
AUTH_COOKIE_SECURE=true
AUTH_COOKIE_SAMESITE=Lax
AUTH_SESSION_COOKIE_NAME=cognisense_session
AUTH_CSRF_COOKIE_NAME=cognisense_csrf
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_WINDOW_SECONDS=900

# Maximum number of active projects allowed per user.
COGNISENSE_MAX_PROJECTS_PER_USER=20

# Maximum number of active API keys allowed per project.
COGNISENSE_MAX_ACTIVE_KEYS_PER_PROJECT=10
